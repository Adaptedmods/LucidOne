[gd_project]

config_version=5

[application]

config/name="Lucidity"
config/description="A Godot-based 3D game and interactive-experience creation engine"
run/main_scene="res://scenes/editor_main.tscn"
config/features=PackedStringArray("4.2", "forward_plus")
config/icon="res://assets/icon.svg"

[autoload]

EditorState="res://scripts/autoload/editor_state.gd"

[rendering]

textures/canvas_textures/default_texture_filter=0
global_illumination/caustics/filter_scale=3.0
